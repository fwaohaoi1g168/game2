[
 {
  "id": "father_01_01",
  "spk": "父",
  "scene": "01",
  "text": "千鶴、喜べ。おまえの縁談が決まったぞ"
 },
 {
  "id": "chizuru_01_01",
  "spk": "千鶴",
  "scene": "01",
  "text": "……縁談、でございますか"
 },
 {
  "id": "father_01_02",
  "spk": "父",
  "scene": "01",
  "text": "鷲尾銀行の三男坊だ。市電の線路を延ばすには、銀行と仲良くしておかねばならんからな。わっはっは"
 },
 {
  "id": "chizuru_01_02",
  "spk": "千鶴",
  "scene": "01",
  "text": "お父様。わたくし、その方にお会いしたこともございませんわ"
 },
 {
  "id": "father_01_03",
  "spk": "父",
  "scene": "01",
  "text": "会わずともよい。わしが会った。なかなかの好青年だったぞ"
 },
 {
  "id": "chizuru_01_03",
  "spk": "千鶴",
  "scene": "01",
  "text": "お父様が恋をなさるわけではございませんでしょう"
 },
 {
  "id": "father_01_04",
  "spk": "父",
  "scene": "01",
  "text": "わっはっは、うまいことを言う"
 },
 {
  "id": "chizuru_01_04",
  "spk": "千鶴",
  "scene": "01",
  "text": "わたくし、一度でいいから、自分で選んだ方と恋をしてみたいのです。本の中ではなく、本物の街で"
 },
 {
  "id": "father_01_05",
  "spk": "父",
  "scene": "01",
  "text": "街だと？　ならん、ならん"
 },
 {
  "id": "father_01_06",
  "spk": "父",
  "scene": "01",
  "text": "あそこは人が多い。スリも出る。近ごろは人さらいまで出るというではないか"
 },
 {
  "id": "father_01_07",
  "spk": "父",
  "scene": "01",
  "text": "ひとりで外へなど、とんでもない。……まあ、腕の立つ護衛でもおれば、話は別だがな"
 },
 {
  "id": "chizuru_01_05",
  "spk": "千鶴",
  "scene": "01",
  "text": "護衛……"
 },
 {
  "id": "father_01_08",
  "spk": "父",
  "scene": "01",
  "text": "さて、わしは会社へ行く。縁談の席は来週の日曜だ。着物を選んでおきなさい"
 },
 {
  "id": "chizuru_01_06",
  "spk": "千鶴",
  "scene": "01",
  "text": "……来週の日曜。でしたら、今日はまだ、わたくしの日ですわね"
 },
 {
  "id": "chizuru_02_01",
  "spk": "千鶴",
  "scene": "02",
  "text": "本に書いてあった通りですわ。計画とは、観察の積み重ねである、と"
 },
 {
  "id": "chizuru_02_02",
  "spk": "千鶴",
  "scene": "02",
  "text": "行ってまいります。……どなたにも、聞こえていないでしょうけれど"
 },
 {
  "id": "chizuru_03_01",
  "spk": "千鶴",
  "scene": "03",
  "text": "動いておりますわ……！　本の挿絵より、ずっと大きい！"
 },
 {
  "id": "chizuru_03_02",
  "spk": "千鶴",
  "scene": "03",
  "text": "いけない、見とれている場合ではありませんわ。今日の目的は、恋です"
 },
 {
  "id": "chizuru_03_03",
  "spk": "千鶴",
  "scene": "03",
  "text": "出会いのきっかけは、まず手みやげから。……手みやげ、手みやげ"
 },
 {
  "id": "kudamono_03_01",
  "spk": "果物屋",
  "scene": "03",
  "text": "お嬢ちゃん、林檎どうだい。今朝とれたての、甘いやつだよ"
 },
 {
  "id": "chizuru_03_04",
  "spk": "千鶴",
  "scene": "03",
  "text": "まあ！　それをくださいまし。ええと……五つ"
 },
 {
  "id": "kudamono_03_02",
  "spk": "果物屋",
  "scene": "03",
  "text": "い、五つ！？"
 },
 {
  "id": "chizuru_03_05",
  "spk": "千鶴",
  "scene": "03",
  "text": "さて。どなたに声をかけましょう"
 },
 {
  "id": "chizuru_03a_01",
  "spk": "千鶴",
  "scene": "03a",
  "text": "あの。その本、『月下の航海記』の下巻ではございませんか"
 },
 {
  "id": "shosei_03a_01",
  "spk": "書生",
  "scene": "03a",
  "text": "えっ。そうですけど……よくご存じですね"
 },
 {
  "id": "chizuru_03a_02",
  "spk": "千鶴",
  "scene": "03a",
  "text": "わたくしも読みましたの。三章の嵐の場面、すばらしいですわよね。船長が帆柱にしがみついて"
 },
 {
  "id": "shosei_03a_02",
  "spk": "書生",
  "scene": "03a",
  "text": "そうそう！　あそこで船長が泣くんですよね。僕も泣きました"
 },
 {
  "id": "chizuru_03a_03",
  "spk": "千鶴",
  "scene": "03a",
  "text": "わかりますわ！"
 },
 {
  "id": "shosei_03a_03",
  "spk": "書生",
  "scene": "03a",
  "text": "いやあ、楽しかった。こんなに話の合う人は初めてです"
 },
 {
  "id": "chizuru_03a_04",
  "spk": "千鶴",
  "scene": "03a",
  "text": "わたくしもですわ。あの、よろしければ、このあと"
 },
 {
  "id": "shosei_03a_04",
  "spk": "書生",
  "scene": "03a",
  "text": "あ、下巻の続きを今夜中に読みたいので。じゃあ、また本屋で！"
 },
 {
  "id": "chizuru_03a_05",
  "spk": "千鶴",
  "scene": "03a",
  "text": "……本のお話しか、していませんでしたわね"
 },
 {
  "id": "shafu_03b_01",
  "spk": "車夫",
  "scene": "03b",
  "text": "よしな、よしな。昼間っから、みっともねえ"
 },
 {
  "id": "chizuru_03b_01",
  "spk": "千鶴",
  "scene": "03b",
  "text": "なんて頼もしい方……！"
 },
 {
  "id": "chizuru_03b_02",
  "spk": "千鶴",
  "scene": "03b",
  "text": "あの！　お見事でしたわ。これ、お礼のしるしに"
 },
 {
  "id": "shafu_03b_02",
  "spk": "車夫",
  "scene": "03b",
  "text": "お礼？　俺は何もしてねえよ。それより、そんなに林檎を抱えてたら重いだろ。気をつけて帰んな"
 },
 {
  "id": "chizuru_03b_03",
  "spk": "千鶴",
  "scene": "03b",
  "text": "あの、お名前を"
 },
 {
  "id": "shafu_03b_03",
  "spk": "車夫",
  "scene": "03b",
  "text": "名乗るほどのもんじゃねえ。おっと、お客だ。毎度！"
 },
 {
  "id": "chizuru_03b_04",
  "spk": "千鶴",
  "scene": "03b",
  "text": "……受け取ってすら、いただけませんでしたわ"
 },
 {
  "id": "nigaoe_03c_01",
  "spk": "似顔絵描き",
  "scene": "03c",
  "text": "似顔絵、一枚十銭。お嬢さん、描いていくかい"
 },
 {
  "id": "chizuru_03c_01",
  "spk": "千鶴",
  "scene": "03c",
  "text": "まあ、お願いいたしますわ。……それで、描いていただくあいだに、少しお話を"
 },
 {
  "id": "nigaoe_03c_02",
  "spk": "似顔絵描き",
  "scene": "03c",
  "text": "はいはい。じっとしててね"
 },
 {
  "id": "nigaoe_03c_03",
  "spk": "似顔絵描き",
  "scene": "03c",
  "text": "はい、できあがり"
 },
 {
  "id": "chizuru_03c_02",
  "spk": "千鶴",
  "scene": "03c",
  "text": "あの、うしろのお屋敷は"
 },
 {
  "id": "nigaoe_03c_04",
  "spk": "似顔絵描き",
  "scene": "03c",
  "text": "お嬢さん、いいとこの子でしょ。手袋も、しゃべり方も、隠せてないよ"
 },
 {
  "id": "nigaoe_03c_05",
  "spk": "似顔絵描き",
  "scene": "03c",
  "text": "悪いこと言わないから、早くおうちに帰りな。このへん、近ごろ人さらいが出るって噂だからさ"
 },
 {
  "id": "chizuru_03c_03",
  "spk": "千鶴",
  "scene": "03c",
  "text": "わ、わたくしはただ、お話を……"
 },
 {
  "id": "nigaoe_03c_06",
  "spk": "似顔絵描き",
  "scene": "03c",
  "text": "はい、十銭ね。毎度あり"
 },
 {
  "id": "chizuru_03c_04",
  "spk": "千鶴",
  "scene": "03c",
  "text": "……子ども扱い、されてしまいましたわ"
 },
 {
  "id": "chizuru_03_06",
  "spk": "千鶴",
  "scene": "03",
  "text": "みなさん、親切でしたわ。でも……"
 },
 {
  "id": "chizuru_03_07",
  "spk": "千鶴",
  "scene": "03",
  "text": "どなたも、わたくしの手を取ってはくださいませんでしたわね"
 },
 {
  "id": "tetsuji_04_01",
  "spk": "鉄次",
  "scene": "04",
  "text": "――お嬢さん"
 },
 {
  "id": "tetsuji_04_02",
  "spk": "鉄次",
  "scene": "04",
  "text": "道に迷ったんだろう。じきに日も暮れる。お屋敷まで、送ってやろうか"
 },
 {
  "id": "chizuru_04_01",
  "spk": "千鶴",
  "scene": "04",
  "text": "……声を、かけていただけましたわ"
 },
 {
  "id": "tetsuji_04_03",
  "spk": "鉄次",
  "scene": "04",
  "text": "は？"
 },
 {
  "id": "chizuru_04_02",
  "spk": "千鶴",
  "scene": "04",
  "text": "今日はいちにち、わたくしから声をかけてばかりでしたの。殿方のほうから声をかけていただいたのは、はじめてです！"
 },
 {
  "id": "tetsuji_04_04",
  "spk": "鉄次",
  "scene": "04",
  "text": "お、おう。そりゃあ、よかったな"
 },
 {
  "id": "chizuru_04_03",
  "spk": "千鶴",
  "scene": "04",
  "text": "でも、ひとつだけ。どうして、わたくしがお屋敷に住んでいると、おわかりになったのですか"
 },
 {
  "id": "tetsuji_04_05",
  "spk": "鉄次",
  "scene": "04",
  "text": "そ、そりゃあ、その、見りゃわかる。手袋とか"
 },
 {
  "id": "chizuru_04_04",
  "spk": "千鶴",
  "scene": "04",
  "text": "まあ。手袋ひとつで、わかってしまうものですのね"
 },
 {
  "id": "tetsuji_04_06",
  "spk": "鉄次",
  "scene": "04",
  "text": "と、とにかく行こうぜ。こっちだ"
 },
 {
  "id": "chizuru_04_05",
  "spk": "千鶴",
  "scene": "04",
  "text": "お待ちになって。お手を、拝借できます？"
 },
 {
  "id": "tetsuji_04_07",
  "spk": "鉄次",
  "scene": "04",
  "text": "手？"
 },
 {
  "id": "tetsuji_04_08",
  "spk": "鉄次",
  "scene": "04",
  "text": "おわっ、重っ……！"
 },
 {
  "id": "chizuru_04_06",
  "spk": "千鶴",
  "scene": "04",
  "text": "ありがとうございます。ずっと抱えていて、腕がしびれておりましたの"
 },
 {
  "id": "chizuru_05_01",
  "spk": "千鶴",
  "scene": "05",
  "text": "あら？"
 },
 {
  "id": "chizuru_05_02",
  "spk": "千鶴",
  "scene": "05",
  "text": "あなた、人さらいですわね"
 },
 {
  "id": "tetsuji_05_01",
  "spk": "鉄次",
  "scene": "05",
  "text": "……な、なにを言って"
 },
 {
  "id": "chizuru_05_03",
  "spk": "千鶴",
  "scene": "05",
  "text": "爪の紫のしみ。あれは眠り薬の色ですわ。それに、親切な道案内のふりをして、ひと気のない道へ連れていく。本に載っていた手口と、そっくりそのままです"
 },
 {
  "id": "tetsuji_05_02",
  "spk": "鉄次",
  "scene": "05",
  "text": "……だったら、どうする。ここで大声でも出すか"
 },
 {
  "id": "chizuru_05_04",
  "spk": "千鶴",
  "scene": "05",
  "text": "いいえ。出しませんわ"
 },
 {
  "id": "tetsuji_05_03",
  "spk": "鉄次",
  "scene": "05",
  "text": "……は？"
 },
 {
  "id": "chizuru_05_05",
  "spk": "千鶴",
  "scene": "05",
  "text": "だってあなた、さっきから手が震えていらっしゃいますもの"
 },
 {
  "id": "chizuru_05_06",
  "spk": "千鶴",
  "scene": "05",
  "text": "靴も、ずいぶんすり減っていますわね。きっと、うまくいかずに逃げてばかり。……本当は、このお仕事、向いていらっしゃらないのでは？"
 },
 {
  "id": "tetsuji_05_04",
  "spk": "鉄次",
  "scene": "05",
  "text": "う、うるせえ！　余計なお世話だ！"
 },
 {
  "id": "chizuru_05_07",
  "spk": "千鶴",
  "scene": "05",
  "text": "お名前は？"
 },
 {
  "id": "tetsuji_05_05",
  "spk": "鉄次",
  "scene": "05",
  "text": "なんで人さらいが名乗るんだよ"
 },
 {
  "id": "chizuru_05_08",
  "spk": "千鶴",
  "scene": "05",
  "text": "お名前は？"
 },
 {
  "id": "tetsuji_05_06",
  "spk": "鉄次",
  "scene": "05",
  "text": "……熊谷。熊谷鉄次"
 },
 {
  "id": "chizuru_05_09",
  "spk": "千鶴",
  "scene": "05",
  "text": "鉄次さん。わたくしは、千鶴と申します"
 },
 {
  "id": "chizuru_06_01",
  "spk": "千鶴",
  "scene": "06",
  "text": "鉄次さん。ご提案がございますの"
 },
 {
  "id": "tetsuji_06_01",
  "spk": "鉄次",
  "scene": "06",
  "text": "……提案？"
 },
 {
  "id": "chizuru_06_02",
  "spk": "千鶴",
  "scene": "06",
  "text": "わたくしを、お屋敷まで送ってくださいまし。護衛として、あなたを雇います"
 },
 {
  "id": "tetsuji_06_02",
  "spk": "鉄次",
  "scene": "06",
  "text": "はあ！？　俺は、あんたをさらおうとしてた人間だぞ"
 },
 {
  "id": "chizuru_06_03",
  "spk": "千鶴",
  "scene": "06",
  "text": "ええ。ですから、お願いしているのです"
 },
 {
  "id": "chizuru_06_04",
  "spk": "千鶴",
  "scene": "06",
  "text": "人をさらう方なら、人をさらう方の手口も、裏道も、よくご存じでしょう？　護衛にこれほど向いた方はおりませんわ"
 },
 {
  "id": "tetsuji_06_03",
  "spk": "鉄次",
  "scene": "06",
  "text": "……罠だろ。屋敷に着いたとたん、巡査がずらっと並んでるんだろ"
 },
 {
  "id": "chizuru_06_05",
  "spk": "千鶴",
  "scene": "06",
  "text": "まあ、疑り深い。では、条件をお出しします"
 },
 {
  "id": "chizuru_06a_01",
  "spk": "千鶴",
  "scene": "06a",
  "text": "お給金をお支払いします。こちらを"
 },
 {
  "id": "tetsuji_06a_01",
  "spk": "鉄次",
  "scene": "06a",
  "text": "ちょ、おい、林檎の上に……いくらあるんだ、これ"
 },
 {
  "id": "chizuru_06a_02",
  "spk": "千鶴",
  "scene": "06a",
  "text": "今日のお小遣いの残りですわ。林檎を五つ買いましたので、少し減ってしまいましたけれど"
 },
 {
  "id": "tetsuji_06a_02",
  "spk": "鉄次",
  "scene": "06a",
  "text": "……俺のひと月分より多いじゃねえか"
 },
 {
  "id": "chizuru_06a_03",
  "spk": "千鶴",
  "scene": "06a",
  "text": "では、ひと月分のお給金を、前払いということで"
 },
 {
  "id": "tetsuji_06a_03",
  "spk": "鉄次",
  "scene": "06a",
  "text": "ひと月も雇う気かよ！？"
 },
 {
  "id": "chizuru_06b_01",
  "spk": "千鶴",
  "scene": "06b",
  "text": "お仕事を、ご紹介いたします"
 },
 {
  "id": "tetsuji_06b_01",
  "spk": "鉄次",
  "scene": "06b",
  "text": "仕事？"
 },
 {
  "id": "chizuru_06b_02",
  "spk": "千鶴",
  "scene": "06b",
  "text": "人さらいより、ずっとまっとうなお仕事を。わたくしの家なら、働き口はいくらでもございますわ"
 },
 {
  "id": "tetsuji_06b_02",
  "spk": "鉄次",
  "scene": "06b",
  "text": "……あんたの家って、いったい何なんだよ"
 },
 {
  "id": "chizuru_06b_03",
  "spk": "千鶴",
  "scene": "06b",
  "text": "それは、着いてのお楽しみです"
 },
 {
  "id": "tetsuji_06b_03",
  "spk": "鉄次",
  "scene": "06b",
  "text": "楽しみにできる気がしねえ……"
 },
 {
  "id": "chizuru_06c_01",
  "spk": "千鶴",
  "scene": "06c",
  "text": "今日のことは、どなたにも申しません"
 },
 {
  "id": "tetsuji_06c_01",
  "spk": "鉄次",
  "scene": "06c",
  "text": "……誰にも？"
 },
 {
  "id": "chizuru_06c_02",
  "spk": "千鶴",
  "scene": "06c",
  "text": "ええ。巡査さんにも、新聞屋さんにも。わたくしを無事に送り届けてくだされば、今日のあなたは人さらいではなく、ただの親切な護衛です"
 },
 {
  "id": "tetsuji_06c_02",
  "spk": "鉄次",
  "scene": "06c",
  "text": "……それ、断ったらどうなる"
 },
 {
  "id": "chizuru_06c_03",
  "spk": "千鶴",
  "scene": "06c",
  "text": "あら。大きな声の出し方なら、本で読みましたわ"
 },
 {
  "id": "tetsuji_06c_03",
  "spk": "鉄次",
  "scene": "06c",
  "text": "脅しじゃねえか！"
 },
 {
  "id": "tetsuji_06_04",
  "spk": "鉄次",
  "scene": "06",
  "text": "……なあ。なんでそこまでして、俺なんだ"
 },
 {
  "id": "tetsuji_06_05",
  "spk": "鉄次",
  "scene": "06",
  "text": "あんたなら、もっとまともな護衛がいくらでも雇えるだろ。なんで、よりによって人さらいを"
 },
 {
  "id": "chizuru_06_06",
  "spk": "千鶴",
  "scene": "06",
  "text": "わたくし、今日、たくさんの方に声をかけましたの"
 },
 {
  "id": "chizuru_06_07",
  "spk": "千鶴",
  "scene": "06",
  "text": "みなさん、いい方でした。お話をしてくださって、心配もしてくださいました。でも、それだけでした"
 },
 {
  "id": "chizuru_06_08",
  "spk": "千鶴",
  "scene": "06",
  "text": "わたくしの手を取って、どこかへ行こうとしてくださった方は、ひとりもいなかった"
 },
 {
  "id": "chizuru_06_09",
  "spk": "千鶴",
  "scene": "06",
  "text": "あなたが、はじめてです。あなたのほうから、わたくしに声をかけてくださった"
 },
 {
  "id": "tetsuji_06_06",
  "spk": "鉄次",
  "scene": "06",
  "text": "……さらうためにな"
 },
 {
  "id": "chizuru_06_10",
  "spk": "千鶴",
  "scene": "06",
  "text": "ええ。理由のほうは、まったくいただけませんけれど"
 },
 {
  "id": "chizuru_06_11",
  "spk": "千鶴",
  "scene": "06",
  "text": "それでも、うれしかったのです。ですから、あなたを手放すつもりはございません"
 },
 {
  "id": "chizuru_06_12",
  "spk": "千鶴",
  "scene": "06",
  "text": "今度は、わたくしがあなたを連れて帰ります"
 },
 {
  "id": "tetsuji_06_07",
  "spk": "鉄次",
  "scene": "06",
  "text": "……わかったよ。送るだけだ。屋敷の前まで送ったら、俺は消えるからな"
 },
 {
  "id": "chizuru_06_13",
  "spk": "千鶴",
  "scene": "06",
  "text": "ええ、それで結構ですわ。……ひとまずは"
 },
 {
  "id": "tetsuji_06_08",
  "spk": "鉄次",
  "scene": "06",
  "text": "今、ひとまずって言ったか？"
 },
 {
  "id": "tetsuji_06_09",
  "spk": "鉄次",
  "scene": "06",
  "text": "で、屋敷ってのはどこだ。名字くらい教えろ"
 },
 {
  "id": "chizuru_06_14",
  "spk": "千鶴",
  "scene": "06",
  "text": "花小路と申します"
 },
 {
  "id": "tetsuji_06_10",
  "spk": "鉄次",
  "scene": "06",
  "text": "……はなこうじ？"
 },
 {
  "id": "tetsuji_06_11",
  "spk": "鉄次",
  "scene": "06",
  "text": "花小路って、あの、市電の会社の、花小路か……？"
 },
 {
  "id": "chizuru_06_15",
  "spk": "千鶴",
  "scene": "06",
  "text": "父の会社ですわ。この道の線路も、父が引きましたの"
 },
 {
  "id": "tetsuji_06_12",
  "spk": "鉄次",
  "scene": "06",
  "text": "帝都でいちばんの金持ちの娘じゃねえか……そんなのに手ぇ出そうとしてたのか、俺……"
 },
 {
  "id": "chizuru_06_16",
  "spk": "千鶴",
  "scene": "06",
  "text": "ええ。ですから今日のあなたは、運がよかったのですわ。わたくしに見抜かれて"
 },
 {
  "id": "tetsuji_06_13",
  "spk": "鉄次",
  "scene": "06",
  "text": "どういう理屈だよ……"
 },
 {
  "id": "tetsuji_07_01",
  "spk": "鉄次",
  "scene": "07",
  "text": "……おい。門、閉まったぞ"
 },
 {
  "id": "chizuru_07_01",
  "spk": "千鶴",
  "scene": "07",
  "text": "ええ。閉まりましたわね"
 },
 {
  "id": "father_07_01",
  "spk": "父",
  "scene": "07",
  "text": "千鶴！　どこへ行っておった。屋敷じゅう大騒ぎだったのだぞ"
 },
 {
  "id": "chizuru_07_02",
  "spk": "千鶴",
  "scene": "07",
  "text": "ごめんなさい、お父様。街へ出ておりました"
 },
 {
  "id": "father_07_02",
  "spk": "父",
  "scene": "07",
  "text": "ひとりで外へなど、とんでもないと言っただろう！"
 },
 {
  "id": "chizuru_07_03",
  "spk": "千鶴",
  "scene": "07",
  "text": "ええ。ですから、ひとりではございませんわ"
 },
 {
  "id": "chizuru_07_04",
  "spk": "千鶴",
  "scene": "07",
  "text": "護衛を連れてまいりました。お父様、おっしゃいましたわよね。腕の立つ護衛がいれば、話は別だと"
 },
 {
  "id": "father_07_03",
  "spk": "父",
  "scene": "07",
  "text": "……む"
 },
 {
  "id": "father_07_04",
  "spk": "父",
  "scene": "07",
  "text": "おまえ、名は"
 },
 {
  "id": "tetsuji_07_02",
  "spk": "鉄次",
  "scene": "07",
  "text": "く、熊谷鉄次……です"
 },
 {
  "id": "father_07_05",
  "spk": "父",
  "scene": "07",
  "text": "ふむ。いい目をしておる。まるで、人をさらう者の目だ"
 },
 {
  "id": "tetsuji_07_03",
  "spk": "鉄次",
  "scene": "07",
  "text": "ひっ"
 },
 {
  "id": "father_07_06",
  "spk": "父",
  "scene": "07",
  "text": "……わっはっは、冗談だ！　護衛はそのくらい鋭い目でないと務まらん"
 },
 {
  "id": "father_07_07",
  "spk": "父",
  "scene": "07",
  "text": "気に入った。熊谷とやら、今日からおまえは千鶴の護衛だ。給金ははずむぞ。住みこみでな"
 },
 {
  "id": "tetsuji_07_04",
  "spk": "鉄次",
  "scene": "07",
  "text": "す、住みこみ！？　いや、俺は送るだけで……"
 },
 {
  "id": "father_07_08",
  "spk": "父",
  "scene": "07",
  "text": "遠慮するな。部屋はいくらでもある。おい、熊谷くんの荷物を運んでやれ"
 },
 {
  "id": "tetsuji_07_05",
  "spk": "鉄次",
  "scene": "07",
  "text": "ちょっ、待っ……俺の帽子……！"
 },
 {
  "id": "chizuru_07_05",
  "spk": "千鶴",
  "scene": "07",
  "text": "お父様。来週の縁談には、護衛と一緒に参りますわ。お相手がどんな方か、わたくし、自分の目で確かめてまいります"
 },
 {
  "id": "father_07_09",
  "spk": "父",
  "scene": "07",
  "text": "む……まあ、会ってみるのはよいことだ"
 },
 {
  "id": "chizuru_07_06",
  "spk": "千鶴",
  "scene": "07",
  "text": "それから、恋のほうも。これから、ゆっくり探しますわ"
 },
 {
  "id": "chizuru_07_07",
  "spk": "千鶴",
  "scene": "07",
  "text": "明日も、お付き合いくださいましね。鉄次さん"
 },
 {
  "id": "tetsuji_07_06",
  "spk": "鉄次",
  "scene": "07",
  "text": "……へい。お嬢"
 }
]